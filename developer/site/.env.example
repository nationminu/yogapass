# ============================================================
# ⚠ 값 줄에 **인라인 주석을 쓰지 않는다** — `docker run --env-file` 과 셸 파싱은 주석을 값의
#   일부로 읽는다(예: TRUSTED_PROXY_COUNT=0  # … → 정수 해석 실패). 설명은 값 줄 위에 둔다.
# developer/site/.env.example — 키와 설명만 둔다. 값은 각자 .env 에 넣는다.
# .env 는 저장소에 커밋하지 않는다(프로젝트 .gitignore 가 제외한다 — REQ-N-018).
# 사용법: cp .env.example .env  후 값을 채운다.
# ============================================================

# ---- 실행 환경 ------------------------------------------------
# local | staging | production
DJANGO_ENV=local
DJANGO_SETTINGS_MODULE=config.settings.local
# production 에서 1이면 기동을 거부한다
DJANGO_DEBUG=1
APP_VERSION=0.1.0-dev
LOG_LEVEL=INFO

# ---- compose ---------------------------------------------------
COMPOSE_PROJECT_NAME=yogapass
# 로컬 기본 프로필 (qa R2 #1 — 플래그 없이 docker compose up 으로 프록시까지 뜬다)
# 작업 12 완료 — backup 프로필을 기본값에 넣었다(로컬에서 run_backup 을 그대로 재현한다)
COMPOSE_PROFILES=proxy,backup
# 운영·스테이징은 devops 가 배포 계획서에서 지정한다
APP_PORT=8000

# ---- 보안 ------------------------------------------------------
# 필수. 임의의 50자 이상 문자열
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:8080
# nginx 경유 시 홉 수 (로컬 proxy 프로필: 1)
TRUSTED_PROXY_COUNT=0
SECURE_SSL_REDIRECT=0
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
# 운영 1차는 86400(1일)부터 시작한다
SECURE_HSTS_SECONDS=0
SESSION_IDLE_MINUTES=30
# 비우면 SECRET_KEY 를 쓴다
RATE_LIMIT_SALT=

# ---- 사이트 ----------------------------------------------------
SITE_NAME=강남 요가패스
# canonical·OG·sitemap 절대 URL 생성 기준
SITE_BASE_URL=http://localhost:8000

# ---- 데이터베이스 ----------------------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=yogapass
POSTGRES_USER=yogapass
# 필수
POSTGRES_PASSWORD=

# ---- 메일 (로컬·스테이징은 Mailpit) ----------------------------
EMAIL_HOST=mail
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
DEFAULT_FROM_EMAIL=no-reply@yogapass.local
INQUIRY_NOTIFY_TO=ops@yogapass.local
OPS_ALERT_TO=ops@yogapass.local
OUTBOX_MAX_ATTEMPTS=5

# ---- 외부 연동 (미설정이면 해당 기능만 비활성) -----------------
MAP_PROVIDER=
MAP_API_KEY=
ANALYTICS_ID=

# ---- 백업 (기술 설계 §12.5) ------------------------------------
# 컨테이너 내부 경로. 호스트 경로는 compose 에서 마운트
BACKUP_DIR=/backups
# 로컬 프로필 전용 호스트 경로
BACKUP_HOST_DIR=./backups
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=3
BACKUP_MIN_FREE_GB=5

# ---- 정책값 ----------------------------------------------------
RETENTION_DAYS__INQUIRY=365
RATE_LIMIT_FORM_WINDOW_MINUTES=10
RATE_LIMIT_FORM_WINDOW_MAX=5
RATE_LIMIT_FORM_DAY_MAX=20

# ---- 운영 ------------------------------------------------------
GUNICORN_WORKERS=3

# ---- 헬스 폴링 (기술 설계 §3.3 ⓐ) ----------------------------
# ⚠ 항상 앱에 직접 호출한다. nginx 를 경유하지 않고 SITE_BASE_URL 을 쓰지 않는다.
HEALTHCHECK_URL=http://app:8000/healthz
HEALTHCHECK_TIMEOUT_SECONDS=5

# ---- 검증 전용 (기술 설계 §10.6) --------------------------------
# QA_TOOLS_ENABLED=1 인 환경은 반드시 인증 뒤에 둔다. production 과 함께 쓰면 기동을 거부한다.
QA_TOOLS_ENABLED=0
# QA_SESSION_TOKEN=            # qa_session 사용 조건(요건 ⑦)
# QA_RETENTION_MINUTES__INQUIRY=10   # 보관 기간을 분 단위로 단축(요건 ④ — 항목별 독립)
# QA_CLOCK_OFFSET_SECONDS=0
# QA_FAIL_INJECT=
# QA_RATE_LIMIT_MODE=
